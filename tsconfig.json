{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mockup-studio/core": [
        "packages/core/src/index.ts"
      ],
      "@mockup-studio/render": [
        "packages/render/src/index.ts"
      ],
      "@mockup-studio/presets": [
        "packages/presets/src/index.ts"
      ],
      "@mockup-studio/media": [
        "packages/media/src/index.ts"
      ],
      "@mockup-studio/editor": [
        "packages/editor/src/index.ts"
      ],
      "@mockup-studio/sdk": [
        "packages/sdk/src/index.ts"
      ],
      "@mockup-studio/spatial": [
        "packages/spatial/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts"
  ]
}
