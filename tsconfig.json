{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@bookklik/device-mockup-studio": [
        "packages/sdk/src/index.ts"
      ],
      "@bookklik/device-mockup-studio/headless": [
        "packages/sdk/src/headless.ts"
      ],
      "@bookklik/device-mockup-studio-core": [
        "packages/core/src/index.ts"
      ],
      "@bookklik/device-mockup-studio-presets": [
        "packages/presets/src/index.ts"
      ],
      "@bookklik/device-mockup-studio-render": [
        "packages/render/src/index.ts"
      ],
      "@bookklik/device-mockup-studio-media": [
        "packages/media/src/index.ts"
      ],
      "@bookklik/device-mockup-studio-editor": [
        "packages/editor/src/index.ts"
      ],
      "@bookklik/device-mockup-studio-spatial": [
        "packages/spatial/src/index.ts"
      ]
    }
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "artifacts",
    "packages/*/dist",
    "apps/demo/dist"
  ]
}
