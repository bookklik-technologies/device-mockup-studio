{
  "name": "@bookklik/device-mockup-studio",
  "version": "0.3.2",
  "type": "module",
  "description": "Compose animated device mockups and export them as PNG, GIF, or video. Framework-independent TypeScript toolkit with modular ESM subpath imports, an optional embeddable editor, and a UI-free headless SDK.",
  "license": "MIT",
  "homepage": "https://bookklik-technologies.github.io/device-mockup-studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/bookklik-technologies/device-mockup-studio.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/bookklik-technologies/device-mockup-studio/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "import": "./dist/headless.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js"
    },
    "./spatial": {
      "types": "./dist/spatial/index.d.ts",
      "import": "./dist/spatial/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@types/three": "0.180.0",
    "@webgpu/types": "0.1.74",
    "gifenc": "1.0.3",
    "lucide": "^1.61.0",
    "mp4-muxer": "5.2.2",
    "three": "0.180.0",
    "webm-muxer": "5.1.4"
  }
}
